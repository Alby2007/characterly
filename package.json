{
  "name": "characterly",
  "version": "0.1.0",
  "description": "A Discord bot where each member awakens a permanent personal AI companion in DMs and summons them into shared servers.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Alby2007/characterly.git"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "ops:requeue-dead-jobs": "tsx scripts/requeue-dead-jobs.mjs",
    "ops:maintain": "tsx scripts/maintain.mjs",
    "ops:verify-memories": "tsx scripts/verify-memories.mjs",
    "ops:contest-sweep": "tsx scripts/contest-sweep.mjs",
    "ops:build-profiles": "tsx scripts/build-profiles.mjs",
    "ops:backfill-relationships": "tsx scripts/backfill-relationships.mjs",
    "ops:purge-nonopted": "tsx scripts/purge-nonopted.mjs",
    "ops:seo": "tsx scripts/seo-report.mjs"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "openai": "^7.43.0",
    "postgres": "^3.4.5",
    "tsx": "^4.20.4",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
