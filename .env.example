DISCORD_TOKEN=
GROQ_API_KEY=
# openai/gpt-oss-120b (recommended — replies, live extraction, event classification)
# or openai/gpt-oss-20b (faster/cheaper, but flakier on judgment tasks)
GROQ_MODEL=openai/gpt-oss-120b
# Supabase (or any Postgres) connection string. Use Session pooler (port 5432) for a long-lived bot process.
# Find it in your Supabase project: Settings → Database → Connection string → Session mode
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Set to one server while testing. Leave empty to enable all servers the bot joins.
GUILD_ID=
# Public URL of the Characterly website — /link replies point users here.
# SITE_URL=https://characterly-website.albertjemmettwaite.workers.dev
# Start conservative. 0.70 means the bot will usually speak only when asked.
SPEAK_THRESHOLD=0.70
# Raw Discord message archive only. Curated memory evidence is retained separately.
RAW_MESSAGE_RETENTION_DAYS=30
# Memories below this confidence begin as candidates and are never used in replies.
CANDIDATE_CONFIDENCE_THRESHOLD=0.70
# Optional: per-workload overrides. qwen/qwen3.8-27b is proven for batched
# strict-schema work (extraction, triage, verification, contest checks) and has
# higher rate limits; gpt-oss-120b is better for low-volume quality calls.
# INGEST_MODEL=qwen/qwen3.8-27b
# INGEST_TRIAGE_MODEL=qwen/qwen3.8-27b
# PROFILE_MODEL=openai/gpt-oss-120b
# VERIFY_MODEL=qwen/qwen3.8-27b — sincerity check that gates candidate→active promotion
# CONTEST_MODEL=qwen/qwen3.8-27b — denial/correction checks on bot-addressed messages
# DOSSIER_MODEL=openai/gpt-oss-120b — dossier sections (falls back to PROFILE_MODEL)
# REPLY_MODEL=groq/compound — agentic replies with server-side web_search + visit_website
#   tools (billed per tool call; falls back to GROQ_MODEL on failure). Unset = plain replies.
# REPLY_TOOLS=1 — free alternative: attach local web_search/visit_url tools to replies
#   on GROQ_MODEL (or REPLY_MODEL if non-compound). Only attaches when the message
#   cues it (URL, question, search-y words); the model decides whether to call them.
# REPLY_EXIT=0 — ignore the reply model's end_conversation flag: wrap-ups the
#   dismissal regex can't parse keep the in-conversation bonus until the TTL.
#   Default honors it; regex dismissal works either way.
# REPLY_BURST=4 / REPLY_REFILL_MS=30000 — per-user reply budget: a burst of
#   quick exchanges is free, then replies throttle to ~1/refill per user.
#   Bounds the drain one person spamming mentions can cause against the
#   guild's daily LLM cap; a natural ~30s-pace conversation flows forever.
#   Suppression is silent.

# BYOK (hosted mode): master passphrase for encrypting per-guild LLM keys at
# rest (AES-256-GCM, SHA-256-derived). Required for /setup to work. Any string.
# KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-passphrase
# REQUIRE_GUILD_KEYS=1 — hosted mode: keyless guilds go fully dormant (no
# archive, no replies) instead of sharing the operator's GROQ_API_KEY.

# ── Hosted credits ("tokens" in user-facing copy) ───────────────────────────
# Lazy grants: applied inside the spend transaction when the date rolls — no
# scheduler needed. Free users refill to FREE_DAILY_CREDITS each UTC day;
# premium refills to PREMIUM_DAILY_CREDITS daily (150 = "practically
# unlimited" for a human, still metered so abuse stays bounded).
# FREE_DAILY_CREDITS=30
# PREMIUM_DAILY_CREDITS=150
# HOSTED_DAILY_LLM_CAP=20000 — fleet-wide circuit breaker: total hosted-lane
#   LLM calls per UTC day regardless of per-user balances. Bounds worst-case
#   operator spend (abuse, retry storms). BYOK calls never count.
# LOW_CREDIT_ALERT=5 — DM the user when a post-spend balance reaches this.
# LINK_PROMPT_COOLDOWN_MS=14400000 — how often an unlinked user gets the
#   "link your account" prompt (default 4h).

# ── Companion marketplace (hub-server forum) ─────────────────────────────────
# MARKETPLACE_CHANNEL_ID — forum channel in the hub server where /companion
#   action:publish posts listing threads. Unset disables publishing.
# MARKETPLACE_MOD_CHANNEL_ID — optional channel that gets pinged on reports.
# ADOPTION_COOLDOWN_MS=43200000 — per-listing re-adopt cooldown after a drop (12h).
# FREE_ADOPTION_SLOTS=1 — active adoptions a free account may hold (premium uncapped).
# FREE_LISTING_SLOTS=2 — live listings a free account may publish (premium uncapped).
# MARKETPLACE_REPORT_FLAG_THRESHOLD=3 — reports that auto-flag a listing.
# MARKETPLACE_MOD_ROLE_IDS — comma-separated role ids allowed to use the mod
#   action buttons on report pings (ManageGuild members can always act).
# MARKET_PUBLISH_DAILY_CAP=5 — new listings per creator per day.
# MARKET_REPORT_DAILY_CAP=20 — reports per user per day (anti-bombing).
# MARKET_ADOPT_DAILY_CAP=20 — adoptions per user per day (anti-farming).
# SAFETY_MODEL — model used for listing/reply classification; defaults to
#   GROQ_MODEL. Any small fast model works.

# ── House ops (private operator layer — OUR server + host only) ──────────────
# Entirely opt-in: HOUSE_GUILD_ID unset disables the layer (no extra intents,
# no listeners, no watchdog).
# HOUSE_GUILD_ID — our community server; gates member ops + automod + /ops.
#   NOTE: setting it also requests the privileged GuildMembers intent —
#   toggle "Server Members Intent" in the dev portal first or login fails.
# HOUSE_MEMBER_ROLE_ID — "verified Characterly member" role, granted by the
#   verify-gate button after a linked-account check; auto-revoked by a
#   periodic sweep when the account is unlinked on the website.
# HOUSE_WELCOME_CHANNEL_ID — welcome posts land here.
# HOUSE_RULES_CHANNEL_ID — pointed at from welcomes.
# HOUSE_VERIFY_CHANNEL_ID — the lobby gate channel; a persistent verify card
#   lives here (posted once on boot if missing).
# HOUSE_ANNOUNCE_CHANNEL_ID — /ops announce target.
# OPS_CHANNEL_ID — ops alerts + host breach notices (default: the mod channel).
# OPS_USER_IDS — comma-separated Discord user ids allowed to run /ops
#   (controls the host: status/logs/restart/deploy — person-level allowlist).
# OPS_REPO_DIR=~/characterly — repo checkout on the host for /ops deploy.
# AUTOMOD_BURST_COUNT=6 — messages in the window that trip burst spam.
# AUTOMOD_BURST_WINDOW_MS=8000
# AUTOMOD_MENTION_MAX=8 — mentions over this = mass mention.
# AUTOMOD_NEW_ACCOUNT_DAYS=7 — accounts younger than this can't post links.
# AUTOMOD_RAID_JOINS=8 — joins in 60s that trigger the raid alert.
# AUTOMOD_RAID_KICK — "1" auto-kicks new joins while a raid window is hot
#   (default OFF — alert only; kicking is one-way).
# HOST_HEAP_PCT=90 / HOST_DISK_PCT=85 / HOST_LAG_MS=1000 — watchdog breaches.
# HOST_HEALTH_INTERVAL_MS=300000 — watchdog tick (5m).
