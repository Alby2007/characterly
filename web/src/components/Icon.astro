---
// One stroke icon set (24px grid, 2px stroke) so marks read as a family.
interface Props { name: "arrow" | "pin" | "edit" | "forget" | "discord" | "menu" | "close" | "upload" | "lock" | "check" | "plus"; size?: number; label?: string }
const { name, size = 18, label } = Astro.props;
const paths: Record<Props["name"], string> = {
  arrow: "M4 12h15M13 6l6 6-6 6",
  pin: "M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z",
  edit: "M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4",
  forget: "M6 6l12 12M18 6L6 18",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
  upload: "M12 16V4M7 9l5-5 5 5M5 20h14",
  lock: "M7 11V8a5 5 0 0110 0v3M6 11h12v9H6z",
  check: "M5 12.5l4.5 4.5L19 7.5",
  plus: "M12 5v14M5 12h14",
  discord: "",
};
---
{name === "discord" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}>
    <path d="M19.6 5.3A16.6 16.6 0 0015.5 4l-.5 1a15.3 15.3 0 00-6 0l-.5-1a16.6 16.6 0 00-4.1 1.3C1.8 9.2 1.1 13 1.4 16.7a16.8 16.8 0 005 2.5l1.1-1.7a10.8 10.8 0 01-1.7-.8l.4-.3a11.9 11.9 0 0011.6 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.7a16.7 16.7 0 005-2.5c.4-4.3-.7-8-3.1-11.4zM8.7 14.5c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z" />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}>
    <path d={paths[name]} />
  </svg>
)}
