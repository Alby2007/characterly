---
// Rendered (via Astro.rewrite) for unknown, private or banned creator slugs,
// with a real 404 status so dead pages drop out of search instead of lingering.
import Base from "../../layouts/Base.astro";

export const prerender = false;
Astro.response.status = 404;
---
<Base title="No such creator · Characterly" description="That creator page doesn't exist." path="/characters" noindex>
  <section class="wrap gone">
    <h1>No such creator.</h1>
    <p class="lede">That creator page doesn't exist — it may have been renamed or taken private. The shelf is still open.</p>
    <p><a class="btn" href="/characters">Browse the shelf</a></p>
  </section>
</Base>

<style>
  .gone { padding-top: 96px; display: grid; gap: 20px; justify-items: start; }
</style>
